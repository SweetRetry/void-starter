{
  "name": "void-starter",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo dev --filter=web",
    "build": "turbo build",
    "deploy": "pnpm --filter web run deploy",
    "connect": "pnpm --filter web connect",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "typecheck": "turbo typecheck",
    "test": "vp test run",
    "e2e": "node scripts/e2e.js",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "md:check": "markdownlint-cli2",
    "md:fix": "markdownlint-cli2 --fix",
    "zod:check": "node rules/zod-v4/check.js",
    "ui:check": "node .agents/skills/sweet-mode/scripts/ui-guardrails.js",
    "ui:freeze": "node scripts/ui-freeze.js",
    "ui:freeze:update": "node scripts/ui-freeze.js --update",
    "skills:check": "node scripts/agent-skills.js",
    "skills:update": "node scripts/agent-skills.js --update",
    "rules:check": "pnpm zod:check && pnpm ui:check && pnpm ui:freeze && pnpm skills:check",
    "knip": "knip",
    "verify": "pnpm format:check && pnpm md:check && pnpm lint && pnpm rules:check && pnpm typecheck && pnpm test && pnpm build && pnpm knip"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@workspace/typescript-config": "workspace:*",
    "knip": "^6.33.0",
    "lefthook": "^2.1.14",
    "markdownlint-cli2": "^0.23.3",
    "playwright": "^1.64.1",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
    "vite-plus": "^1.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.0.0"
}
