{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["packages/ui"],
  "ignore": ["scripts/**", "rules/**", "**/routeTree.gen.ts"],
  "workspaces": {
    ".": {
      "entry": ["vite.config.ts"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx",
        "src/routes/**/*.{ts,tsx}",
        "db/schema.ts",
        "env.ts",
        "void.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "db/**/*.ts", "*.ts"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": ["*.json"]
    }
  }
}
