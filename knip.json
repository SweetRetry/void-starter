{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["rules/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/e2e-browser.js"],
      "ignoreDependencies": ["vite"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}", "db/schema.ts", "void.config.ts"],
      "project": ["src/**/*.{ts,tsx,css}", "db/**/*.ts", "*.ts"],
      "ignoreDependencies": ["cloudflare", "tailwindcss"],
      "vite": false
    },
    "packages/ui": {
      "entry": [
        "src/components/**/*.tsx",
        "src/lib/**/*.ts",
        "src/hooks/**/*.ts",
        "src/styles/*.css"
      ],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": []
    }
  }
}
