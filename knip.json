{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["packages/ui"],
  "ignore": ["scripts/**", "rules/**"],
  "workspaces": {
    ".": {
      "ignoreDependencies": ["vite"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}", "db/schema.ts", "void.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "db/**/*.ts", "*.ts"],
      "ignoreDependencies": ["cloudflare", "tailwindcss"],
      "vite": false,
      "ignore": ["src/components/{agents,scroll-rail,ui}/**", "src/lib/{ease.ts,hooks/**}"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": []
    }
  }
}
